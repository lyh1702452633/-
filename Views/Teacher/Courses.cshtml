@model IEnumerable<StudentManagementSystem.Models.Course>

@{
    ViewData["Title"] = "我的课程";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-book"></i> 我的课程
                    </h3>
                    <div class="card-tools">
                        <a href="@Url.Action("Index")" class="btn btn-secondary btn-sm">
                            <i class="fas fa-arrow-left"></i> 返回主页
                        </a>
                    </div>
                </div>
                
                <div class="card-body">
                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>课程代码</th>
                                        <th>课程名称</th>
                                        <th>学分</th>
                                        <th>课程描述</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var course in Model)
                                    {
                                        <tr>
                                            <td>@course.CourseCode</td>
                                            <td>@course.CourseName</td>
                                            <td>@course.Credits</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(course.Description))
                                                {
                                                    @if (course.Description.Length > 50)
                                                    {
                                                        <span title="@course.Description">
                                                            @course.Description.Substring(0, 50)...
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        @course.Description
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">无描述</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("Students", new { courseId = course.CourseId })" 
                                                       class="btn btn-sm btn-info" title="查看学生">
                                                        <i class="fas fa-users"></i> 学生
                                                    </a>
                                                    <a href="@Url.Action("Grades", new { courseId = course.CourseId })" 
                                                       class="btn btn-sm btn-success" title="查看成绩">
                                                        <i class="fas fa-chart-line"></i> 成绩
                                                    </a>
                                                    <a href="@Url.Action("Attendance", new { courseId = course.CourseId })" 
                                                       class="btn btn-sm btn-warning" title="查看考勤">
                                                        <i class="fas fa-calendar-check"></i> 考勤
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="row mt-3">
                            <div class="col-sm-12 col-md-5">
                                <div class="dataTables_info">
                                    共显示 @Model.Count() 门课程
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center">
                            <p>您暂时没有分配到任何课程</p>
                            <a href="@Url.Action("Index")" class="btn btn-secondary">
                                <i class="fas fa-arrow-left"></i> 返回主页
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('.table').addClass('table-hover');
        });
    </script>
} 