@model IEnumerable<StudentManagementSystem.Models.Course>

@{
    ViewData["Title"] = "课程管理";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">课程管理</h3>
                    <div class="card-tools">
                        <a href="@Url.Action("CreateCourse")" class="btn btn-primary btn-sm">
                            <i class="fas fa-plus"></i> 添加课程
                        </a>
                    </div>
                </div>
                
                <div class="card-body">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible">
                            <button type="button" class="close" data-dismiss="alert" aria-hidden="true">&times;</button>
                            <h5><i class="icon fas fa-ban"></i> 错误!</h5>
                            @ViewBag.Error
                        </div>
                    }

                    @if (Model != null && Model.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-striped">
                                <thead>
                                    <tr>
                                        <th>课程代码</th>
                                        <th>课程名称</th>
                                        <th>学分</th>
                                        <th>授课教师</th>
                                        <th>教师编号</th>
                                        <th>描述</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var course in Model)
                                    {
                                        <tr>
                                            <td>@course.CourseCode</td>
                                            <td>@course.CourseName</td>
                                            <td>@course.Credits</td>
                                            <td>@(course.Teacher?.Name ?? "未指定")</td>
                                            <td>@(course.Teacher?.TeacherNumber ?? "未指定")</td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(course.Description))
                                                {
                                                    @if (course.Description.Length > 50)
                                                    {
                                                        <span title="@course.Description">
                                                            @course.Description.Substring(0, 50)...
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        @course.Description
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">暂无描述</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a href="@Url.Action("EditCourse", new { id = course.CourseId })" 
                                                       class="btn btn-sm btn-info" title="编辑">
                                                        <i class="fas fa-edit"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-sm btn-danger" 
                                                            onclick="confirmDelete(@course.CourseId, '@course.CourseName')" 
                                                            title="删除">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                  
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        
                        <div class="row mt-3">
                            <div class="col-sm-12 col-md-5">
                                <div class="dataTables_info">
                                    共显示 @Model.Count() 条记录
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="text-center">
                            <p>暂无课程信息</p>
                            <a href="@Url.Action("CreateCourse")" class="btn btn-primary">
                                <i class="fas fa-plus"></i> 添加第一个课程
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- 删除确认模态框 -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">确认删除</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>确定要删除课程 <strong id="courseName"></strong> 吗？</p>
                <p class="text-danger">此操作将同时删除该课程的所有成绩和考勤记录，且无法恢复。</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
                <form id="deleteForm" method="post" style="display: inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">确认删除</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmDelete(courseId, courseName) {
            $('#courseName').text(courseName);
            $('#deleteForm').attr('action', '@Url.Action("DeleteCourse")/' + courseId);
            
            // Bootstrap 5 模态框调用方式
            var deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
            deleteModal.show();
        }
        
        // 初始化表格功能
        $(document).ready(function() {
            $('.table').addClass('table-hover');
        });
    </script>
} 