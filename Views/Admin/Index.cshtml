@{
    ViewData["Title"] = "管理员首页";
}

<div class="row">
    <div class="col-12">
        <h2><i class="bi bi-speedometer2"></i> 系统概览</h2>
        <p class="text-muted">管理员：@ViewBag.Username</p>
        <hr>
    </div>
</div>

<div class="row">
    <!-- 统计卡片 -->
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-header">
                <i class="bi bi-people"></i> 学生总数
            </div>
            <div class="card-body">
                <h4 class="card-title">@ViewBag.TotalStudents</h4>
                <p class="card-text">注册学生数量</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-header">
                <i class="bi bi-person-workspace"></i> 教师总数
            </div>
            <div class="card-body">
                <h4 class="card-title">@ViewBag.TotalTeachers</h4>
                <p class="card-text">在职教师数量</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-header">
                <i class="bi bi-book"></i> 课程总数
            </div>
            <div class="card-body">
                <h4 class="card-title">@ViewBag.TotalCourses</h4>
                <p class="card-text">开设课程数量</p>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-header">
                <i class="bi bi-person-badge"></i> 用户总数
            </div>
            <div class="card-body">
                <h4 class="card-title">@ViewBag.TotalUsers</h4>
                <p class="card-text">系统用户数量</p>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- 快捷操作 -->
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-grid-3x3-gap"></i> 快捷操作
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-6 mb-3">
                        <a href="@Url.Action("Students", "Admin")" class="btn btn-outline-primary w-100 h-100 d-flex flex-column justify-content-center align-items-center">
                            <i class="bi bi-people fs-1"></i>
                            <span class="mt-2">学生管理</span>
                        </a>
                    </div>
                    <div class="col-6 mb-3">
                        <a href="@Url.Action("Teachers", "Admin")" class="btn btn-outline-success w-100 h-100 d-flex flex-column justify-content-center align-items-center">
                            <i class="bi bi-person-workspace fs-1"></i>
                            <span class="mt-2">教师管理</span>
                        </a>
                    </div>
                    <div class="col-6 mb-3">
                        <a href="@Url.Action("Courses", "Admin")" class="btn btn-outline-info w-100 h-100 d-flex flex-column justify-content-center align-items-center">
                            <i class="bi bi-book fs-1"></i>
                            <span class="mt-2">课程管理</span>
                        </a>
                    </div>
                    <div class="col-6 mb-3">
                        <a href="@Url.Action("Grades", "Admin")" class="btn btn-outline-warning w-100 h-100 d-flex flex-column justify-content-center align-items-center">
                            <i class="bi bi-clipboard-data fs-1"></i>
                            <span class="mt-2">成绩管理</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div> 