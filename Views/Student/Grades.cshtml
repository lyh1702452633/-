@model List<Grade>
@{
    ViewData["Title"] = "我的成绩";
}

<div class="row">
    <div class="col-12">
        <h2><i class="bi bi-clipboard-data"></i> 我的成绩</h2>
        <p class="text-muted">学生：@ViewBag.StudentName</p>
        <hr>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-table"></i> 成绩记录
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>课程代码</th>
                                    <th>课程名称</th>
                                    <th>任课教师</th>
                                    <th>考试类型</th>
                                    <th>考试日期</th>
                                    <th>成绩</th>
                                    <th>等级</th>
                                    <th>状态</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var grade in Model)
                                {
                                    <tr>
                                        <td>@grade.Course.CourseCode</td>
                                        <td>@grade.Course.CourseName</td>
                                        <td>@grade.Course.Teacher.Name</td>
                                        <td>@grade.ExamType</td>
                                        <td>@grade.ExamDate.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            <span class="badge @(grade.Score >= 90 ? "bg-success" : grade.Score >= 80 ? "bg-primary" : grade.Score >= 70 ? "bg-info" : grade.Score >= 60 ? "bg-warning" : "bg-danger")">
                                                @grade.Score.ToString("F1")
                                            </span>
                                        </td>
                                        <td>
                                            @if (grade.Score >= 90)
                                            {
                                                <span class="text-success">优秀</span>
                                            }
                                            else if (grade.Score >= 80)
                                            {
                                                <span class="text-primary">良好</span>
                                            }
                                            else if (grade.Score >= 70)
                                            {
                                                <span class="text-info">中等</span>
                                            }
                                            else if (grade.Score >= 60)
                                            {
                                                <span class="text-warning">及格</span>
                                            }
                                            else
                                            {
                                                <span class="text-danger">不及格</span>
                                            }
                                        </td>
                                        <td>
                                            @if (grade.Score >= 60)
                                            {
                                                <span><i class="bi bi-check-circle-fill text-success"></i> 通过</span>
                                            }
                                            else
                                            {
                                                <span><i class="bi bi-x-circle-fill text-danger"></i> 未通过</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- 统计信息 -->
                    <div class="row mt-4">
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h5 class="card-title text-primary">@Model.Count</h5>
                                    <p class="card-text">总科目数</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h5 class="card-title text-success">@Model.Count(g => g.Score >= 60)</h5>
                                    <p class="card-text">及格科目</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h5 class="card-title text-danger">@Model.Count(g => g.Score < 60)</h5>
                                    <p class="card-text">不及格科目</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h5 class="card-title text-info">@(Model.Any() ? Model.Average(g => g.Score).ToString("F1") : "0.0")</h5>
                                    <p class="card-text">平均分</p>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox text-muted" style="font-size: 3rem;"></i>
                        <h5 class="mt-3 text-muted">暂无成绩记录</h5>
                        <p class="text-muted">请联系任课教师录入成绩</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div> 