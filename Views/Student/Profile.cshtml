@model StudentManagementSystem.Models.Student

@{
    ViewData["Title"] = "个人档案";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-user"></i>
                        个人档案
                    </h3>
                </div>
                
                <div class="card-body">
                    @if (ViewBag.Success != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle"></i>
                            @ViewBag.Success
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle"></i>
                            @ViewBag.Error
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <form asp-action="Profile" method="post">
                        <div class="row">
                            <!-- 基本信息（只读） -->
                            <div class="col-md-6">
                                <h5 class="text-primary mb-3">
                                    <i class="fas fa-id-card"></i>
                                    基本信息
                                </h5>
                                
                                <div class="mb-3">
                                    <label class="form-label">学号</label>
                                    <input type="text" class="form-control" value="@Model.StudentNumber" readonly>
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label">姓名</label>
                                    <input type="text" class="form-control" value="@Model.Name" readonly>
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label">性别</label>
                                    <input type="text" class="form-control" value="@Model.Gender" readonly>
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label">出生日期</label>
                                    <input type="text" class="form-control" value="@Model.BirthDate?.ToString("yyyy-MM-dd")" readonly>
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label">班级</label>
                                    <input type="text" class="form-control" value="@Model.Class" readonly>
                                </div>
                                
                                <div class="mb-3">
                                    <label class="form-label">入学日期</label>
                                    <input type="text" class="form-control" value="@Model.EnrollmentDate.ToString("yyyy-MM-dd")" readonly>
                                </div>
                            </div>
                            
                            <!-- 可编辑信息 -->
                            <div class="col-md-6">
                                <h5 class="text-success mb-3">
                                    <i class="fas fa-edit"></i>
                                    可编辑信息
                                </h5>
                                
                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label">邮箱</label>
                                    <input asp-for="Email" type="email" class="form-control" placeholder="请输入邮箱地址">
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>
                                
                                <div class="mb-3">
                                    <label asp-for="Phone" class="form-label">电话</label>
                                    <input asp-for="Phone" type="tel" class="form-control" placeholder="请输入联系电话">
                                    <span asp-validation-for="Phone" class="text-danger"></span>
                                </div>
                                
                                <div class="mb-3">
                                    <label asp-for="Address" class="form-label">地址</label>
                                    <textarea asp-for="Address" class="form-control" rows="4" placeholder="请输入详细地址"></textarea>
                                    <span asp-validation-for="Address" class="text-danger"></span>
                                </div>
                                
                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="fas fa-save"></i>
                                        更新信息
                                    </button>
                                    <a asp-action="Index" class="btn btn-secondary">
                                        <i class="fas fa-arrow-left"></i>
                                        返回首页
                                    </a>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // 自动隐藏成功消息
        setTimeout(function() {
            $('.alert-success').fadeOut('slow');
        }, 3000);
    </script>
} 