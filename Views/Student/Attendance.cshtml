@model List<Attendance>
@{
    ViewData["Title"] = "我的考勤";
}

<div class="row">
    <div class="col-12">
        <h2><i class="bi bi-calendar-check"></i> 我的考勤</h2>
        <p class="text-muted">学生：@ViewBag.StudentName</p>
        <hr>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-table"></i> 考勤记录
            </div>
            <div class="card-body">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th>课程代码</th>
                                    <th>课程名称</th>
                                    <th>任课教师</th>
                                    <th>考勤日期</th>
                                    <th>考勤状态</th>
                                    <th>备注</th>
                                    <th>记录时间</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var attendance in Model)
                                {
                                    <tr>
                                        <td>@attendance.Course.CourseCode</td>
                                        <td>@attendance.Course.CourseName</td>
                                        <td>@attendance.Course.Teacher.Name</td>
                                        <td>@attendance.AttendanceDate.ToString("yyyy-MM-dd")</td>
                                        <td>
                                            @switch (attendance.Status)
                                            {
                                                case AttendanceStatus.Present:
                                                    <span class="badge bg-success">
                                                        <i class="bi bi-check-circle"></i> 出勤
                                                    </span>
                                                    break;
                                                case AttendanceStatus.Absent:
                                                    <span class="badge bg-danger">
                                                        <i class="bi bi-x-circle"></i> 缺勤
                                                    </span>
                                                    break;
                                                case AttendanceStatus.Late:
                                                    <span class="badge bg-warning">
                                                        <i class="bi bi-clock"></i> 迟到
                                                    </span>
                                                    break;
                                                case AttendanceStatus.Leave:
                                                    <span class="badge bg-info">
                                                        <i class="bi bi-person-check"></i> 请假
                                                    </span>
                                                    break;
                                                default:
                                                    <span class="badge bg-secondary">未知</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrEmpty(attendance.Remarks))
                                            {
                                                @if (attendance.Remarks.Length > 20)
                                                {
                                                    <span title="@attendance.Remarks">
                                                        @attendance.Remarks.Substring(0, 20)...
                                                    </span>
                                                }
                                                else
                                                {
                                                    @attendance.Remarks
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">无</span>
                                            }
                                        </td>
                                        <td>@attendance.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- 统计信息 -->
                    <div class="row mt-4">
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h5 class="card-title text-primary">@Model.Count</h5>
                                    <p class="card-text">总考勤次数</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h5 class="card-title text-success">@Model.Count(a => a.Status == AttendanceStatus.Present)</h5>
                                    <p class="card-text">出勤次数</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h5 class="card-title text-danger">@Model.Count(a => a.Status == AttendanceStatus.Absent)</h5>
                                    <p class="card-text">缺勤次数</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center">
                                <div class="card-body">
                                    <h5 class="card-title text-info">
                                        @if (Model.Count > 0)
                                        {
                                            @(((double)Model.Count(a => a.Status == AttendanceStatus.Present) / Model.Count * 100).ToString("F1") + "%")
                                        }
                                        else
                                        {
                                            @("0.0%")
                                        }
                                    </h5>
                                    <p class="card-text">出勤率</p>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- 详细统计 -->
                    <div class="row mt-3">
                        <div class="col-md-3">
                            <div class="card text-center border-warning">
                                <div class="card-body">
                                    <h5 class="card-title text-warning">@Model.Count(a => a.Status == AttendanceStatus.Late)</h5>
                                    <p class="card-text">迟到次数</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="card text-center border-info">
                                <div class="card-body">
                                    <h5 class="card-title text-info">@Model.Count(a => a.Status == AttendanceStatus.Leave)</h5>
                                    <p class="card-text">请假次数</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <h6 class="card-title">考勤状态说明</h6>
                                    <div class="row">
                                        <div class="col-6">
                                            <small class="text-muted">
                                                <span class="badge bg-success me-1">出勤</span> 正常到课<br>
                                                <span class="badge bg-danger me-1">缺勤</span> 无故缺席
                                            </small>
                                        </div>
                                        <div class="col-6">
                                            <small class="text-muted">
                                                <span class="badge bg-warning me-1">迟到</span> 迟到到课<br>
                                                <span class="badge bg-info me-1">请假</span> 请假缺席
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-calendar-x text-muted" style="font-size: 3rem;"></i>
                        <h5 class="mt-3 text-muted">暂无考勤记录</h5>
                        <p class="text-muted">请联系任课教师录入考勤信息</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div> 