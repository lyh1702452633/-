<!DOCTYPE html>
<html lang="zh-cn">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - 学生信息管理系统</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-primary fixed-top">
            <div class="container-fluid">
                <a class="navbar-brand" href="#">学生信息管理系统</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto">
                        @if (ViewBag.UserRole != null)
                        {
                            @if ((StudentManagementSystem.Models.UserRole)ViewBag.UserRole == StudentManagementSystem.Models.UserRole.Student)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "Student")">首页</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Grades", "Student")">我的成绩</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Attendance", "Student")">我的考勤</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Profile", "Student")">个人资料</a>
                                </li>
                            }
                            else if ((StudentManagementSystem.Models.UserRole)ViewBag.UserRole == StudentManagementSystem.Models.UserRole.Teacher)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "Teacher")">首页</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Courses", "Teacher")">我的课程</a>
                                </li>
                            }
                            else if ((StudentManagementSystem.Models.UserRole)ViewBag.UserRole == StudentManagementSystem.Models.UserRole.Admin)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Index", "Admin")">首页</a>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="studentDropdown" role="button" data-bs-toggle="dropdown">
                                        学生管理
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="@Url.Action("Students", "Admin")">学生列表</a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("CreateStudent", "Admin")">添加学生</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="teacherDropdown" role="button" data-bs-toggle="dropdown">
                                        教师管理
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="@Url.Action("Teachers", "Admin")">教师列表</a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("CreateTeacher", "Admin")">添加教师</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="courseDropdown" role="button" data-bs-toggle="dropdown">
                                        课程管理
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li><a class="dropdown-item" href="@Url.Action("Courses", "Admin")">课程列表</a></li>
                                        <li><a class="dropdown-item" href="@Url.Action("CreateCourse", "Admin")">添加课程</a></li>
                                    </ul>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" href="@Url.Action("Grades", "Admin")">成绩管理</a>
                                </li>
                             
                            }
                        }
                    </ul>
                    <ul class="navbar-nav">
                        @if (ViewBag.Username != null)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle"></i> @ViewBag.Username
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="@Url.Action("Logout", "Account")">退出登录</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container-fluid" style="margin-top: 70px;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html> 